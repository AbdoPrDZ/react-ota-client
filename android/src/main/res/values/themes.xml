<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Themes for the optional native activities. Both follow the host's DayNight
      mode, so a dark-themed app gets a dark splash without extra configuration.
    -->
    <style name="Theme.OtaClient.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <style name="Theme.OtaClient.Splash" parent="Theme.OtaClient.Base" />

    <style name="Theme.OtaClient.Configure" parent="Theme.OtaClient.Base" />

</resources>
